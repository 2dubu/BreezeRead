{
  "manifest_version": 3,
  "name": "BreezeRead Sidebar",
  "version": "1.0",
  "description": "NAVER 뉴스의 읽기 시간 · 핵심 요약 · 키워드 관련 기사 · 북마크를 기능을 좌측 사이드바 한 곳에서 빠르게 확인하세요.",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "permissions": ["scripting", "storage"],
  "host_permissions": [
    "https://news.naver.com/*",
    "https://n.news.naver.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://n.news.naver.com/article/*",
        "https://n.news.naver.com/mnews/article/*"
      ],
      "js": ["src/content.js"],
      "css": ["src/style.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/main.html", "src/style.css", "assets/*.png"],
      "matches": ["https://n.news.naver.com/*"]
    }
  ]
}
