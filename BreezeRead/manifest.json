{
  "manifest_version": 3,
  "name": "BreezeRead Sidebar",
  "version": "1.1",
  "description": "웹페이지 왼쪽에 사이드바를 띄우는 확장",
  "permissions": ["scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["capdi.html", "style.css"],
      "matches": ["<all_urls>"]
    }
  ]
}