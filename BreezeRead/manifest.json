{
  "manifest_version": 3,
  "name": "BreezeRead Sidebar",
  "version": "1.1",
  "description": "웹페이지 왼쪽에 사이드바를 띄우는 확장",
  "icons": { "128": "assets/icon128.jpg" },
  "permissions": [
    "scripting",
     "storage"
    ],
  "host_permissions": [
    "https://news.naver.com/*",
    "https://n.news.naver.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://news.naver.com/*", "https://n.news.naver.com/*"],
      "js": ["./src/content.js"],
      "css":["./src/style.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["capdi.html", "style.css"],
      "matches": ["https://news.naver.com/*", "https://n.news.naver.com/*"]
    }
  ]
}