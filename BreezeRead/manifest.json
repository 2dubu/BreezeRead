{
  "manifest_version": 3,
  "name": "BreezeRead Sidebar",
  "version": "0.1.1",
  "description": "네이버 뉴스 요약 확장 프로그램입니다.",
  "icons": { 
    "128": "assets/icon128.jpg" 
  },
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://news.naver.com/*",
    "https://n.news.naver.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://news.naver.com/*", "https://n.news.naver.com/*"],
      "js": ["src/content.js"],
      "css":["src/style.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/main.html", "src/style.css"],
      "matches": ["https://news.naver.com/*", "https://n.news.naver.com/*"]
    }
  ]
}